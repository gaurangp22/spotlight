# Local development discovers the Metro host automatically. Set an HTTPS API URL for release builds.
EXPO_PUBLIC_API_URL=
# Optional: the deployed web app URL used in shared links. Without it, links open the installed app.
EXPO_PUBLIC_WEB_URL=
# Optional: shown as "Contact support" in Settings. Stores require a support contact on the listing either way.
EXPO_PUBLIC_SUPPORT_EMAIL=
