PORT=8787
HOST=0.0.0.0
# Leave both blank to run against the local SQLite database.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Required in production: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=
PUBLIC_API_URL=http://127.0.0.1:8787
WEB_APP_URL=http://localhost:8081
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
SPOTIFY_CLIENT_ID=
# Optional, server-only. With the client secret, the server searches Spotify for everyone (songs,
# albums, artists) and imports pasted Spotify links. Provider access/quota rules still apply.
# The current Riffs feature batch uses keyless catalogs and does not need these credentials.
SPOTIFY_CLIENT_SECRET=
# Only needed for "Connect Spotify" (top tracks, private playlists). Register this EXACT URL in Spotify.
# Use HTTPS when connecting from a phone.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8787/api/spotify/callback
# Optional: enables movie search. Free key or read-access token from https://www.themoviedb.org/settings/api
TMDB_API_KEY=
# Enables signup verification, email OTP sign-in, and password recovery (Resend).
RESEND_API_KEY=
EMAIL_FROM=
# Optional: Expo push delivery. Also configure FCM/APNs in a native build; users must opt in.
PUSH_ENABLED=0
# Only needed when access-token security is enabled in the Expo push dashboard. Server-only.
EXPO_ACCESS_TOKEN=
# Optional server-only token, at least 32 characters, for admin.mjs (stats, feedback, moderation).
ADMIN_TOKEN=
# Optional: shown on invite pages as "Download for Android" (Play Store or APK link).
ANDROID_DOWNLOAD_URL=
# Optional: trust only the IP address of your reverse proxy for rate limiting.
# Caddy on this machine, for example: 127.0.0.1,::1,::ffff:127.0.0.1
# On Render, Railway, or Fly.io (always behind their proxy), use: *
TRUSTED_PROXY_IPS=
# Optional: labelled house bots that post real music and greet new members. Users can hide them.
RIFFS_BOTS=0
# Bot pacing (defaults: 8 posts a day, at least 45 minutes apart, checked every 5 minutes).
BOT_DAILY_POSTS=8
BOT_POST_GAP_MINUTES=45
BOT_INTERVAL_MINUTES=5
