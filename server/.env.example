PORT=8787
HOST=0.0.0.0
# Leave both blank to run against the local SQLite database.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Required in production: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=
PUBLIC_API_URL=http://127.0.0.1:8787
WEB_APP_URL=http://localhost:8081
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
SPOTIFY_CLIENT_ID=
# Register this EXACT URL in Spotify. Use HTTPS when connecting from a phone.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8787/api/spotify/callback
# Optional for password recovery emails (Resend). Use your verified sender/domain.
RESEND_API_KEY=
EMAIL_FROM=
# Optional server-only moderation token, at least 32 characters.
ADMIN_TOKEN=
# Optional: trust only the IP address of your reverse proxy for rate limiting.
# Caddy on this machine, for example: 127.0.0.1,::1,::ffff:127.0.0.1
TRUSTED_PROXY_IPS=
