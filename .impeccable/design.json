  "narrative": {
    "northStar": "The Radio Program Log",
    "overview": "MARGIN is a working identity for an Android-first local music prototype. The visual world borrows the order, numbering, and confident typography of a radio track sheet. Warm paper and dark listening surfaces frame music artwork; expressive headlines invite people to put their own taste into words and order.",
    "keyCharacteristics": [
      "Editorial and culture-driven.",
      "Artwork supplies the changing color.",
      "Indexed choices make the opinion legible.",
      "Flat, square, confident controls."
    ],
    "rules": [
      {
        "name": "The Artwork Color Rule",
        "body": "Let cover art carry variety. Keep interface color anchored to the established palette.",
