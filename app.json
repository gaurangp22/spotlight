{
  "expo": {
    "name": "Riffs",
    "slug": "margin-music",
    "scheme": "marginmusic",
    "version": "2.0.0",
    "description": "Rate and review the music you love, film quick video reviews, and see exactly where your friends’ taste agrees.",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F2F2F7",
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "bundleIdentifier": "com.marginmusic.app",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.marginmusic.app",
      "adaptiveIcon": {
        "backgroundColor": "#FF2D55",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ],
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "name": "Riffs",
      "themeColor": "#E8174A"
    },
    "plugins": [
      "expo-router",
      "expo-sharing",
      "expo-secure-store",
      "expo-web-browser",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#F2F2F7",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Riffs uses your photos only when you choose a profile photo or a mood board image.",
          "cameraPermission": "Riffs uses the camera only while you record a video review.",
          "microphonePermission": "Riffs uses the microphone only if you turn on sound for a video review."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Riffs uses the camera only while you record a video review.",
          "microphonePermission": "Riffs uses the microphone only if you turn on sound for a video review.",
          "recordAudioAndroid": true,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Riffs saves your video reviews to your library when you tap Save.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": []
        }
      ],
      "expo-video",
      "expo-notifications",
      "expo-build-properties",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": false,
          "microphonePermission": "Riffs uses the microphone only if you turn on sound for a video review."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a7542a50-9223-4585-9221-02c18e4a3751"
      }
    },
    "owner": "gaurang22",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a7542a50-9223-4585-9221-02c18e4a3751"
    }
  }
}
